[Unit]
Description=Shity Swap public read-only API (/api/v1/swap/)
After=network.target

[Service]
Type=simple
User=shitcoin
WorkingDirectory=/opt/shity-swap-api
ExecStart=/usr/bin/python3 /opt/shity-swap-api/swap_api.py
Restart=always
RestartSec=5
Environment=SWAP_API_PORT=8793
# No secrets: read-only quote/RPC reads only. Never signs or executes.

[Install]
WantedBy=multi-user.target
